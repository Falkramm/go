index 0000000..5464199
--- /dev/null
+++ b/pkg/proc/mapiter_test.go
@@ -0,0 +1,64 @@
+package proc
+
+import (
+	"debug/dwarf"
+	"testing"
+
+	"github.com/go-delve/delve/pkg/dwarf/dwarfbuilder"
+)
+
+func TestSwissMapControlEncoding(t *testing.T) {
+	for _, test := range []struct {
+		name         string
+		haveType     bool
+		constantName string
+		empty        byte
+		want         byte
+	}{
+		{"legacy", true, "ctrlEmpty", 0x80, 0x80},
+		{"zero", true, "ctrlEmpty", 0, 0},
+		{"missing-type", false, "", 0, 0x80},
+		{"missing-constant", true, "", 0, 0x80},
+		{"unrelated-constant", true, "ctrlDeleted", 0xfe, 0x80},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			builder := dwarfbuilder.New()
+			builder.Attr(dwarf.AttrProducer, "Go cmd/compile go1.28-devel_22493433")
+			if test.haveType {
+				typ := builder.AddBaseType("internal/runtime/maps.ctrl", dwarfbuilder.DW_ATE_unsigned, 1)
+				if test.constantName != "" {
+					builder.TagOpen(dwarf.TagConstant, "internal/runtime/maps."+test.constantName)
+					builder.Attr(dwarf.AttrType, typ)
+					builder.Attr(dwarf.AttrConstValue, uint64(test.empty))
+					builder.TagClose()
+				}
+			}
+			abbrev, aranges, frame, info, line, pubnames, ranges, str, loc, err := builder.Build()
+			if err != nil {
+				t.Fatal(err)
+			}
+			data, err := dwarf.New(abbrev, aranges, frame, info, line, pubnames, ranges, str)
+			if err != nil {
+				t.Fatal(err)
+			}
+			bi := NewBinaryInfo("linux", "amd64", false)
+			bi.LoadImageFromData(data, frame, line, loc)
+			defer bi.Close()
+			iterator := &mapIteratorSwiss{v: &Variable{bi: bi}, group: &swissGroup{ctrls: make([]byte, 1)}}
+			iterator.loadCtrlEmpty()
+			if iterator.ctrlEmpty != test.want {
+				t.Fatalf("empty control byte = %#x, want %#x", iterator.ctrlEmpty, test.want)
+			}
+			for control := 0; control < 256; control++ {
+				iterator.group.ctrls[0] = byte(control)
+				want := control >= 128
+				if test.want == 0 {
+					want = control < 128
+				}
+				if got := iterator.slotIsEmptyOrDeleted(0); got != want {
+					t.Errorf("control %#x: empty/deleted = %v, want %v", control, got, want)
+				}
+			}
+		})
+	}
+}
